{% extends 'email/base.html.twig' %}

{% block title %}{{ 'reset_password.subject'|trans({}, 'emails') }}{% endblock %}

{% block body %}
    <h1 style="margin:0 0 16px;font-size:22px;font-weight:600;line-height:1.3;color:#1a1f24;">
        {{ 'reset_password.title'|trans({}, 'emails') }}
    </h1>
    <p style="margin:0 0 24px;font-size:15px;line-height:1.55;color:#374151;">
        {{ 'reset_password.intro'|trans({}, 'emails') }}
    </p>
    <p style="margin:0 0 8px;font-size:12px;font-weight:600;letter-spacing:0.04em;text-transform:uppercase;color:#6b7280;">
        {{ 'reset_password.token_label'|trans({}, 'emails') }}
    </p>
    <p style="margin:0 0 24px;padding:16px;background-color:#f3f4f6;border-radius:6px;font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;font-size:14px;line-height:1.5;word-break:break-all;color:#1a1f24;">
        {{ token }}
    </p>
    <p style="margin:0 0 16px;font-size:14px;line-height:1.5;color:#6b7280;">
        {{ 'reset_password.expiry'|trans({}, 'emails') }}
    </p>
    <p style="margin:0;font-size:13px;line-height:1.5;color:#9ca3af;">
        {{ 'reset_password.disclaimer'|trans({}, 'emails') }}
    </p>
{% endblock %}

{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "composer",
    "github-actions"
  ],
  "schedule": [
    "before 6am on monday"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ]
  },
  "packageRules": [
    {
      "description": "Group Symfony 8.1 packages",
      "matchManagers": [
        "composer"
      ],
      "matchPackageNames": [
        "symfony/*"
      ],
      "groupName": "symfony"
    },
    {
      "description": "Group GitHub Actions minor and patch updates",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "github-actions"
    }
  ]
}
